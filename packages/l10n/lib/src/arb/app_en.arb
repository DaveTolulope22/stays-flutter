{
  "@@locale": "en",

  "retry": "Try again",
  "@retry": {
    "description": "Button that repeats a failed action, such as loading the app or a list."
  },

  "loading": "Loading",
  "@loading": {
    "description": "Accessibility label for a loading indicator."
  },

  "errorNetwork": "We couldn't reach the server. Please check your connection and try again.",
  "@errorNetwork": {
    "description": "Shown when a request got no response: offline, timeout or refused connection."
  },

  "errorGeneric": "Something went wrong. Please try again.",
  "@errorGeneric": {
    "description": "Final fallback for any failure that has no more specific message."
  },

  "errorRequestFailed": "The request could not be completed. Please try again.",
  "@errorRequestFailed": {
    "description": "Fallback for a rejected request (4xx) whose messageCode we do not know."
  },

  "errorServer": "Something went wrong on our side. Please try again later.",
  "@errorServer": {
    "description": "Server errors (5xx), including error.internalServerError."
  },

  "errorTenantSetup": "This app is not set up correctly. Please update the app or contact support.",
  "@errorTenantSetup": {
    "description": "error.tenantRequired and error.tenantUnknown: the build's tenant was not accepted."
  },

  "errorBadCredentials": "The email address or password is incorrect.",
  "@errorBadCredentials": {
    "description": "error.badCredentials: shown on the sign-in screen after a wrong login."
  },

  "errorUserAlreadyExists": "An account with this email address already exists.",
  "@errorUserAlreadyExists": {
    "description": "error.userAlreadyExist: registering with an email that is taken."
  },

  "errorFieldRequired": "Please fill in all required fields.",
  "@errorFieldRequired": {
    "description": "error.fieldRequired."
  },

  "errorBadRequest": "That request was not valid. Please check your input and try again.",
  "@errorBadRequest": {
    "description": "error.badRequest."
  },

  "errorSessionExpired": "Your session has expired. Please sign in again.",
  "@errorSessionExpired": {
    "description": "auth.token.invalid.UnauthorizedException and any other 401."
  },

  "errorForbidden": "You do not have access to this.",
  "@errorForbidden": {
    "description": "auth.forbidden.ForbiddenException and any other 403."
  },

  "errorListingNotFound": "This listing could not be found.",
  "@errorListingNotFound": {
    "description": "listing.NotFoundException."
  },

  "errorNotFound": "We could not find what you were looking for.",
  "@errorNotFound": {
    "description": "route.NotFoundException and any other 404."
  },

  "errorRangeTooLong": "Please choose a shorter date range (up to one year).",
  "@errorRangeTooLong": {
    "description": "error.rangeTooLong: a date search or availability window over 366 days."
  },

  "authSignIn": "Sign in",
  "@authSignIn": {
    "description": "Sign-in screen title and its submit button."
  },

  "authRegister": "Create account",
  "@authRegister": {
    "description": "Registration screen title and its submit button."
  },

  "authEmail": "Email address",
  "@authEmail": {
    "description": "Label of the email field."
  },

  "authPassword": "Password",
  "@authPassword": {
    "description": "Label of the password field."
  },

  "authFirstName": "First name",
  "@authFirstName": {
    "description": "Label of the first name field on the registration form."
  },

  "authLastName": "Last name",
  "@authLastName": {
    "description": "Label of the last name field on the registration form."
  },

  "authGoToRegister": "New here? Create an account",
  "@authGoToRegister": {
    "description": "Link on the sign-in screen that opens registration."
  },

  "authGoToSignIn": "Already have an account? Sign in",
  "@authGoToSignIn": {
    "description": "Link on the registration screen that opens sign-in."
  },

  "authShowPassword": "Show password",
  "@authShowPassword": {
    "description": "Tooltip and accessibility label of the button that reveals the password."
  },

  "authHidePassword": "Hide password",
  "@authHidePassword": {
    "description": "Tooltip and accessibility label of the button that hides the password."
  },

  "authErrorRequired": "This field is required.",
  "@authErrorRequired": {
    "description": "Inline error for an empty required field."
  },

  "authErrorEmailInvalid": "Enter a valid email address.",
  "@authErrorEmailInvalid": {
    "description": "Inline error for an email that is not shaped like one."
  },

  "authErrorPasswordTooShort": "Use at least {min} characters.",
  "@authErrorPasswordTooShort": {
    "description": "Inline error for a password shorter than the minimum.",
    "placeholders": {
      "min": {
        "type": "int"
      }
    }
  },

  "authTermsIntro": "By creating an account you agree to:",
  "@authTermsIntro": {
    "description": "Line above the terms and privacy links on the registration screen."
  },

  "authTermsOfUse": "Terms of use",
  "@authTermsOfUse": {
    "description": "Link to the tenant's terms of use."
  },

  "authPrivacyPolicy": "Privacy policy",
  "@authPrivacyPolicy": {
    "description": "Link to the tenant's privacy policy."
  },

  "signOut": "Sign out",
  "@signOut": {
    "description": "Button that ends the session."
  },

  "hostUnavailable": "The host area is not available right now.",
  "@hostUnavailable": {
    "description": "Shown to a host whose tenant has the host panel switched off."
  },

  "authLinkOpenFailed": "The link could not be opened.",
  "@authLinkOpenFailed": {
    "description": "Message shown when the terms or privacy page cannot be opened."
  }
}
